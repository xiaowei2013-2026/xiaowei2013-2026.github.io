{
  "files.exclude": {
    "**/.git": true,
    "**/.tools": true,
    "**/public": true,
    "**/resources": true,
    "**/.hugo_build.lock": true,
    "**/archetypes": true,
    "**/assets": true,
    "**/layouts": true,
    "**/static": true,
    "**/themes": true,
    "**/.github": true,
    "**/.gitmodules": true,
    "**/.gitattributes": true,
    "**/.gitignore": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.tools/**": true,
    "**/public/**": true,
    "**/resources/**": true
  },
  "explorer.compactFolders": true,
  "explorer.sortOrder": "type"
}
